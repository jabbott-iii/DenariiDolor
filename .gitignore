# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Rust build output
/rust/target/

# Flutter and Dart tool state (android/.gitignore and ios/.gitignore cover the host apps)
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/
.widget_preview/
migrate_working_dir/
/android/app/debug
/android/app/profile
/android/app/release

# Obfuscation symbols and maps stay private (M6.3)
app.*.symbols
app.*.map.json

# Gradle working directories (Flutter's android/ host app uses Gradle too)
.gradle/
build/
*/build/
# Signing material must never be committed
*.jks
*.keystore
key.properties
service-account*.json

# Machine-specific SDK path (CI uses ANDROID_HOME)
local.properties

# Release outputs are published only by CD (CS-18)
/app/release/
*.apk
*.aab
*.ipa
*.dm

# The rest of what `flutter create` (Flutter 3.50.1) ignores at the root: the
# iOS build's last build ID, `dart doc` output, Swift Package Manager's folders,
# which Flutter's iOS build uses (M7), and Python bytecode from the tools
**/ios/Flutter/.last_build_id
**/doc/api/
.buildlog/
.build/
.swiftpm/
*.pyc

# iOS signing material must never be committed either (M7): certificates with
# their private keys, provisioning profiles, and App Store Connect API keys
*.p12
*.mobileprovision
*.p8

# Environment files can hold secrets; only the example is shared
.env
.env.*
!.env.example

# Claude Code's personal settings and instructions, which stay on one machine
.claude/settings.local.json
CLAUDE.local.md
