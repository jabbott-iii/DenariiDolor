  "faqDataQ": "Where is my data stored?",
  "@faqDataQ": {
    "description": "Help screen question."
  },
  "faqDataA": "Only on this phone. Denarii Dolor has no account or server and can't connect to the internet. Your records are kept in an encrypted database that only your PIN, your security answer or, if you turn it on, your fingerprint or face can unlock. Android's cloud backup is turned off for the app.",
  "@faqDataA": {
    "description": "Help screen answer."
  },
  "faqForgotPinQ": "I forgot my PIN. What can I do?",
  "@faqForgotPinQ": {
    "description": "Help screen question."
  },
  "faqForgotPinA": "On the sign-in screen, tap “{forgotPin}” and answer your security question to choose a new PIN. If you can't answer it either, your data can't be unlocked, because nobody else has the key. The only way forward then is “{wipeAllData}” on the sign-in screen, which erases everything so you can start over.",
  "@faqForgotPinA": {
    "description": "Help screen answer. The quoted names are the sign-in screen's Forgot PIN and Wipe All App Data buttons, each filled in from its own translated string.",
    "placeholders": {
      "forgotPin": {
        "type": "String",
        "example": "Forgot PIN?"
      },
      "wipeAllData": {
        "type": "String",
        "example": "Wipe All App Data"
      }
    }
  },
  "faqSignedOutQ": "Why was I signed out?",
  "@faqSignedOutQ": {
    "description": "Help screen question."
  },
  "faqSignedOutA": "To protect your data, the app signs you out after {minutes} minutes without use. Sign in again with your PIN, or turn on “{biometricSetting}” in Settings to sign in with your fingerprint or face.",
  "@faqSignedOutA": {
    "description": "Help screen answer: the number of minutes before the app signs out, and the name of the biometric setting, filled in from its own translated string.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "5"
      },
      "biometricSetting": {
        "type": "String",
        "example": "Biometric sign-in"
      }
    }
  },
  "faqBackupQ": "How do I back up my data or move it to a new phone?",
  "@faqBackupQ": {
    "description": "Help screen question."
  },
  "faqBackupA": "In Settings, open “{backupSetting}” and create a backup protected by a passphrase. Save the file somewhere safe, such as a cloud drive. On the new phone, install Denarii Dolor, set it up, then restore the file with the same passphrase. Nobody can recover a forgotten passphrase.",
  "@faqBackupA": {
    "description": "Help screen answer. The quoted name is the Backup and restore setting, filled in from its own translated string.",
    "placeholders": {
      "backupSetting": {
        "type": "String",
        "example": "Backup and restore"
      }
    }
  },
  "faqBudgetsQ": "How do budgets work?",
  "@faqBudgetsQ": {
    "description": "Help screen question."
  },
  "faqBudgetsA": "In Settings, open “{budgetsScreen}” to give a category a monthly limit and a warning threshold. The Dashboard shows how much of each budget you've used this month. If an expense would go over its budget, the app asks before saving it.",
  "@faqBudgetsA": {
    "description": "Help screen answer. The quoted name is the Manage Budgets screen, filled in from its own translated string.",
    "placeholders": {
      "budgetsScreen": {
        "type": "String",
        "example": "Manage Budgets"
      }
    }
  },
  "faqTransferQ": "What is a transfer?",
  "@faqTransferQ": {
    "description": "Help screen question."
  },
  "faqTransferA": "A transfer moves money between two of your accounts, for example from Savings to Cash. It changes both balances but doesn't count as income or as an expense.",
  "@faqTransferA": {
    "description": "Help screen answer."
  },
  "faqDeleteQ": "Why can't I delete a category or an account?",
  "@faqDeleteQ": {
    "description": "Help screen question."
  },
  "faqDeleteA": "The default categories and accounts can't be deleted, and neither can one that transactions still use. Change or delete those transactions first, then try again.",
  "@faqDeleteA": {
    "description": "Help screen answer."
  },
  "faqCurrencyQ": "How do I change the currency?",
  "@faqCurrencyQ": {
    "description": "Help screen question."
  },
  "faqCurrencyA": "In Settings, tap “{currencySetting}” and pick one. Only the symbol changes: amounts you already entered aren't converted.",
  "@faqCurrencyA": {
    "description": "Help screen answer. The quoted name is the Currency setting, filled in from its own translated string.",
    "placeholders": {
      "currencySetting": {
        "type": "String",
        "example": "Currency"
      }
    }
  },
  "faqReportsQ": "How do I export a report?",
  "@faqReportsQ": {
    "description": "Help screen question."
  },
  "faqReportsA": "Open “{reportsScreen}”, choose a month, then save or share it as a PDF or CSV file. Exported files aren't encrypted, so keep them somewhere private.",
  "@faqReportsA": {
    "description": "Help screen answer. The quoted name is the Reports screen, filled in from its own translated string.",
    "placeholders": {
      "reportsScreen": {
        "type": "String",
        "example": "Reports"
      }
    }
  },
  "faqBiometricQ": "Why did fingerprint or face sign-in turn off?",
  "@faqBiometricQ": {
    "description": "Help screen question."
  },
  "faqBiometricA": "It turns off when the fingerprints or faces enrolled on the phone change, so that a newly added one can't open your data. Your PIN still works, and you can turn biometric sign-in back on in Settings.",
  "@faqBiometricA": {
    "description": "Help screen answer."
  },
